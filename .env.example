# ===========================================================================
# Nginx Console 主服务器 —— 环境变量示例
#
# 怎么用：
#   1. 复制本文件为同目录下的 `.env`
#      Linux/macOS：cp .env.example .env
#      Windows     ：Copy-Item .env.example .env
#   2. 按下面的说明修改 `.env`（`.env` 已被 .gitignore 排除，不会进仓库）
#   3. 启动命令会自动读取它：`npm start`（即 node --env-file-if-exists=.env ...）
#      或 `pm2 start ecosystem.config.cjs --only ncs-main`
#      （pm2 通过 `node --env-file-if-exists=.env` 读取，不用在 pm2 里重复配置）
#
# 通用规则：
#   - 开关类变量填 1/0，也接受 true/false、yes/no、on/off。
#   - 以 # 开头的整行是注释；行尾的 # 后面内容也会被当成值的一部分，不要这样写。
#   - 变量名区分大小写，等号两边不要加空格。
#   - 生产环境（NODE_ENV=production）下，配置不安全时程序会直接拒绝启动，
#     这是有意的“宁可起不来，也不要带病上线”。
# ===========================================================================

# ---------------------------------------------------------------------------
# 一、运行环境
# ---------------------------------------------------------------------------

# 【作用】告诉程序现在是什么环境。
#   production = 正式对外服务；development = 本地开发/演示。
# 【默认】不填等于 development。
# 【生产环境会额外强制检查】
#   · NCS_PUBLIC_ORIGIN 必须是 https://
#   · 必须启用 Secure Cookie（除非只监听本机回环地址）
#   · 必须配置 NCS_ALLOWED_ROOTS（不允许使用自动生成的演示目录）
#   · NCS_DEV_ORIGINS、NCS_DEV_UNSAFE_SKIP_NGINX_TEST 会被忽略
# 【填错会怎样】把生产写成 development，会跳过上述安全检查，等于降低安全性。
NODE_ENV=production

# 【作用】主服务器监听哪个网卡地址。
#   · 127.0.0.1 = 只有本机能访问（推荐，由 Nginx/Caddy 反向代理对外提供 HTTPS）
#   · 0.0.0.0   = 所有网卡都能访问（必须自己配好 TLS，否则生产环境会拒绝启动）
# 【默认】127.0.0.1。只允许 IP 或 localhost，写域名会报错。
# 【Windows】同样可用 127.0.0.1。
NCS_HOST=127.0.0.1

# 【作用】主服务器监听的端口。
# 【默认】8787，可填 1-65535。
# 【注意】改了这里，反向代理里的 upstream/代理地址要同步改。
NCS_PORT=8787

# 【作用】这个系统最终被浏览器访问的“来源地址”，格式必须是
#         协议://域名[:端口]，不能带路径、问号或井号。
#   用途有三：
#   1) 校验请求的 Origin（防 CSRF）；
#   2) 决定 Cookie 是否带 Secure 标记；
#   3) 生成子服务器 Agent 的回连地址。
# 【生产强烈建议】且必须是 https://，写成 http:// 会直接启动失败。
# 【默认】不填；生产环境不填会告警，且子服务器 Agent 缺少回连地址。
# 【示例】NCS_PUBLIC_ORIGIN=https://nginx.example.com
#         NCS_PUBLIC_ORIGIN=https://console.example.com:8443   ← 非 443 端口要写出来
# 【填错会怎样】写成 https://x.com/admin 或带参数会直接报错；写成内网地址会导致
#               子服务器连不上、登录时 Origin 校验失败。
NCS_PUBLIC_ORIGIN=https://console.example.com

# 【作用】是否信任“本机反向代理”转发过来的客户端信息
#         （X-Forwarded-For 里的真实 IP、X-Forwarded-Proto 里的 https）。
#   1 = 信任 1 跳代理（Nginx/Caddy 在本机或容器里转发时用这个）
#   0 = 不信任，直接用 TCP 连接的对端地址
# 【默认】0。
# 【什么时候要开】用 Nginx/Caddy 终止 HTTPS 再转发给本程序时，必须开 1，
#                 否则程序看到的所有访问者 IP 都是 127.0.0.1，限速和审计会失真。
# 【安全前提，务必满足】
#   · 8787 端口只能让代理访问（防火墙只放行本机，或绑定 127.0.0.1）；
#   · 代理必须自己写入这两个头（Nginx 用 `proxy_set_header X-Forwarded-For
#     $proxy_add_x_forwarded_for;` 和 `proxy_set_header X-Forwarded-Proto $scheme;`），
#     不能把客户端传来的同名头原样透传。
#   程序只认 X-Forwarded-For 的“最后一跳”（代理实际看到的地址），
#   所以即使客户端伪造了前面的值，也无法绕过登录限速或伪造审计 IP。
# 【填错会怎样】没走代理却设成 1，攻击者可以伪造来源 IP；
#               走了代理却设成 0，所有用户共用一个 IP，限速会误伤。
NCS_TRUST_PROXY=1

# 【作用】允许的 Host 请求头（域名，逗号分隔，不要带端口）。
#   用于防止 DNS 重绑定/错误域名访问。localhost、127.0.0.1、::1 永远放行。
# 【默认】空，但会自动加入监听地址和 NCS_PUBLIC_ORIGIN 的域名。
# 【什么时候要改】用多个域名访问同一套控制台时，把域名都写上。
# 【示例】NCS_ALLOWED_HOSTS=console.example.com,nginx.example.com
NCS_ALLOWED_HOSTS=console.example.com

# ---------------------------------------------------------------------------
# 二、数据与管理员账号
# ---------------------------------------------------------------------------

# 【作用】存放运行数据的目录：store.json（账号/服务器/配置元数据）、
#         master.key（加密 TOTP 密钥用）、main-key.pem（主服务器身份私钥）、
#         audit.jsonl（审计日志）、备份等。
# 【默认】当前工作目录下的 `data`。
# 【安全要求】目录权限 0700（程序会自动尝试设置），不要放在网站根目录。
#             请定期备份，尤其是 master.key——丢了它，已绑定的二次验证会失效。
# 【Linux 示例】NCS_DATA_DIR=/var/lib/nginx-console
# 【Windows 示例】NCS_DATA_DIR=D:/nginx-console-data
NCS_DATA_DIR=/var/lib/nginx-console

# 【作用】管理员登录名。
# 【默认】admin。只允许字母、数字、点、下划线、短横线，最长 64。
NCS_ADMIN_USER=admin

# 【作用】管理员初始口令，至少 12 个字符（建议 20+，混合大小写/数字/符号）。
#
# ！！！最重要的一条 ！！！
#   这个变量只在“第一次启动、数据库里还没有管理员”时被读取一次。
#   账号建好之后再改这里完全无效，改口令请登录后到「账号安全」页面修改。
#
# 【不填会怎样】程序会随机生成一个强口令：
#   · 在终端里直接运行：口令打印在屏幕上，只显示一次；
#   · 用 pm2/systemd 运行（输出不是终端）：口令写入
#     <NCS_DATA_DIR>/initial-admin-password.txt（权限 0600），
#     登录后请立刻改密并删除这个文件。
# 【填错会怎样】少于 12 个字符会启动失败并提示 WEAK_ADMIN_PASSWORD。
#
# 【推荐做法】第一次启动前在这里设一个强口令，启动成功后把它从 .env 删掉或改成空。
NCS_ADMIN_PASSWORD=

# 【作用】登录 Cookie 是否只能通过 HTTPS 传输（Secure 标记）。
# 【默认】如果启用了 HTTPS（NCS_TLS_CERT 或 NCS_PUBLIC_ORIGIN 是 https）就默认 1，否则 0。
# 【生产建议】保持 1。用 HTTP 访问时设为 1 会导致浏览器不保存 Cookie，表现为“登录后又跳回登录页”。
NCS_COOKIE_SECURE=1

# 【作用】会话多久没操作就自动退出（空闲超时），单位：分钟。
# 【默认】60，允许 5-1440。
NCS_SESSION_IDLE_MINUTES=60

# 【作用】无论是否操作，登录多久后强制重新登录（绝对超时），单位：分钟。
# 【默认】720（12 小时），允许 15-1440。
# 【规则】必须大于 NCS_SESSION_IDLE_MINUTES，否则启动失败。
NCS_SESSION_ABSOLUTE_MINUTES=720

# 【作用】新增子服务器时生成的“一次性注册令牌”有效期，单位：分钟。
# 【默认】30，允许 5-1440。令牌超时后可在页面上重新生成。
NCS_ENROLL_TOKEN_MINUTES=30

# ---------------------------------------------------------------------------
# 三、Nginx 工作目录与管理命令
# ---------------------------------------------------------------------------

# 【作用】允许被本控制台管理的 Nginx 配置根目录，逗号分隔的绝对路径。
#   页面上只能选择这些目录内部的路径，任何试图跳出目录的路径都会被拒绝。
# 【生产必填】不填会启动失败（开发环境会自动建一个演示目录）。
# 【要求】目录必须真实存在；填多个时用英文逗号分隔。
# 【Linux 示例】NCS_ALLOWED_ROOTS=/etc/nginx
#               NCS_ALLOWED_ROOTS=/etc/nginx,/opt/nginx/conf
# 【Windows 示例】NCS_ALLOWED_ROOTS=C:/nginx
#   （Windows 路径建议用正斜杠 /，反斜杠在 .env 里容易被当成转义字符）
NCS_ALLOWED_ROOTS=/etc/nginx

# 【作用】主服务器自己（“本地节点”）默认管理哪个工作目录。
# 【默认】NCS_ALLOWED_ROOTS 里的第一个目录。
# 【说明】之后可以在页面上重新选择，选择结果会保存到 store.json；
#         这里填的只是首次启动时的初始值。
NCS_LOCAL_WORKSPACE=/etc/nginx

# 【作用】nginx 可执行文件的绝对路径。程序用它执行 `nginx -t` 校验配置和发信号重载。
# 【默认】/usr/sbin/nginx
# 【Linux 示例】NCS_NGINX_BIN=/usr/sbin/nginx
# 【Windows 示例】NCS_NGINX_BIN=C:/nginx/nginx.exe
# 【填错会怎样】保存配置时会因为跑不了 `nginx -t` 而失败回滚；
#               重启/reload 按钮也会报错。
NCS_NGINX_BIN=/usr/sbin/nginx

# 【作用】nginx 的安装前缀（相当于 `nginx -p` 参数）。
# 【默认】不填。
# 【什么时候要填】nginx 不是系统包安装（例如自己编译到 /usr/local/nginx），
#                 导致它找不到相对路径下的配置/日志时再填。
# NCS_NGINX_PREFIX=/usr/local/nginx

# 【作用】用什么方式重载/重启 Nginx：
#   signal  = 直接给 nginx 进程发信号（跨平台，Windows 只能用这个）
#   systemd = 调用 `systemctl reload/restart nginx`（仅 Linux，需要 systemd）
# 【默认】signal。
# 【建议】用系统服务方式安装的 Nginx 选 systemd，行为更规范；
#         其他情况（源码安装、Windows）用 signal。
NCS_CONTROL_MODE=signal

# 【作用】NCS_CONTROL_MODE=systemd 时要操作的服务名。
# 【默认】nginx。用 `systemctl list-units | grep nginx` 可以看到实际名字。
NCS_SYSTEMD_UNIT=nginx

# 【作用】执行 systemctl / nginx 时是否加 sudo。
# 【默认】0（否）。
# 【什么时候要开】程序以普通用户运行，而 Nginx 配置只有 root 能改/能重载时。
# 【需要配合】把 deploy/nginx-console.sudoers 里的规则装到 /etc/sudoers.d/，
#             只授予必要的命令，不要直接给 ALL。
NCS_USE_SUDO=0

# 【作用】证书放在工作目录下的哪个子目录（相对路径）。
# 【默认】ssl。页面上的“证书管理”会读写这个目录。
NCS_CERT_DIR=ssl

# ---------------------------------------------------------------------------
# 四、TLS（可选）
# ---------------------------------------------------------------------------

# 【作用】让 Node 自己直接监听 HTTPS。
#   推荐做法是“Nginx/Caddy 终止 TLS + NCS_HOST=127.0.0.1”，此时这两项保持注释即可。
#   只有当你想让本程序直接对外提供 HTTPS 时才填。
# 【规则】证书和私钥必须同时配置，只配一个会启动失败。
# 【注意】私钥文件权限要收紧（如 chmod 600），且不要放进 Nginx 工作目录。
# NCS_TLS_CERT=/etc/nginx-console/tls/fullchain.pem
# NCS_TLS_KEY=/etc/nginx-console/tls/privkey.pem

# 【作用】前端静态文件（构建产物）目录。
# 【默认】仓库里的 web/dist（执行 `npm run build -w @ncs/web` 生成）。
# 【什么时候要改】把前端单独部署到别的位置时。
# NCS_WEB_DIST=/opt/nginx-console/web/dist

# ---------------------------------------------------------------------------
# 五、日志
# ---------------------------------------------------------------------------

# 【作用】日志详细程度，从少到多：error < warn < info < debug。
# 【默认】info。
# 【建议】日常用 info；排查问题时临时改 debug，查完改回来（debug 会记录更多细节）。
NCS_LOG_LEVEL=info

# 【作用】日志输出格式：
#   json   = 每行一个 JSON（机器友好，适合 pm2/日志采集）
#   pretty = 单行可读文本（人眼友好，适合本地调试）
# 【默认】输出到终端时用 pretty，输出到文件/管道时自动用 json。
# 【建议】pm2 托管时保持 json，方便检索字段（level、requestId、ip 等）。
NCS_LOG_FORMAT=json

# ---------------------------------------------------------------------------
# 六、仅开发环境使用（生产环境会被忽略并给出告警）
# ---------------------------------------------------------------------------

# 【作用】允许前端 Vite 开发服务器（默认 5173 端口）跨源访问后端接口。
# 【默认】不填。仅 NODE_ENV=development 时生效。
# 【示例】NCS_DEV_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# NCS_DEV_ORIGINS=http://localhost:5173

# 【作用】危险开关：保存配置时跳过 `nginx -t` 语法检测。
#   1 = 跳过。仅用于本机没有安装 Nginx 的演示环境。
# 【默认】0。生产环境无论填什么都会被忽略（始终检测）。
# 【填错会怎样】在开发环境跳过检测，可能把写坏的配置写进工作目录；
#               真正 reload 时 Nginx 会启动失败。
# NCS_DEV_UNSAFE_SKIP_NGINX_TEST=0

# 【作用】“我知道不安全”开关：允许在非本机地址上以明文 HTTP 运行。
# 【默认】0。生产环境默认会拒绝“非回环地址 + 无 TLS + 无反向代理”的组合。
# 【警告】打开后管理员口令、会话 Cookie、注册令牌都可能被网络嗅探。
#   即使打开，生产环境的子服务器注册接口仍要求 HTTPS（本机回环除外）。
# 【只在什么情况用】内网一次性调试，用完立刻关闭。
# NCS_ALLOW_INSECURE_PUBLIC=0
